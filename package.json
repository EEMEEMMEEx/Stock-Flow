{
  "name": "stock-flow-app",
  "private": true,
  "version": "1.9.5",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "build": "vite build",
    "lint": "eslint .",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "preview": "vite preview",
    "test:email": "node --test src/lib/emailRenderer.test.js src/lib/nodemailerTransport.test.js",
    "migrate:r2": "node scripts/migrate-legacy-images-to-r2.mjs",
    "db:backup": "node scripts/backup-full-database.mjs",
    "wiki:sync": "powershell -ExecutionPolicy Bypass -File scripts/sync-wiki.ps1",
    "generate:agents": "python .agents/scripts/generate_manifest.py && python .agents/scripts/dependency_graph.py",
    "check:agents": "python .agents/scripts/validate_kit.py",
    "check:antigravity": "node .agents/hooks/antigravity-doctor.mjs",
    "test:antigravity": "node --test .agents/hooks/tests/antigravity.test.mjs && python -m unittest discover -s .agents/scripts/tests -v",
    "build:antigravity-plugin": "node .agents/hooks/build-plugin.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.6.1",
    "framer-motion": "^11.18.2",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.577.0",
    "nodemailer": "^10.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.15.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "vite": "7.3.6",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "vite": "$vite",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react-hooks": {
      "eslint": "$eslint"
    }
  }
}