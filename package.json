{
  "name": "stock-flow-app",
  "private": true,
  "version": "1.5.6",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:email": "node --test src/lib/emailRenderer.test.js",
    "migrate:r2": "node scripts/migrate-legacy-images-to-r2.mjs",
    "db:backup": "node scripts/backup-full-database.mjs",
    "wiki:sync": "powershell -ExecutionPolicy Bypass -File scripts/sync-wiki.ps1",
    "generate:agents": "python .agents/scripts/generate-manifest.py && python .agents/scripts/dependency-graph.py",
    "check:agents": "python .agents/scripts/validate-kit.py",
    "check:antigravity": "node .agents/hooks/antigravity-doctor.mjs",
    "test:antigravity": "node --test .agents/hooks/tests/antigravity.test.mjs && python -m unittest discover -s .agents/scripts/tests -v",
    "build:antigravity-plugin": "node .agents/hooks/build-plugin.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-table": "^8.20.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "framer-motion": "^11.3.24",
    "lucide-react": "^0.428.0",
    "nodemailer": "^10.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.26.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.4.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "supabase": "^2.113.0",
    "tailwindcss": "^4.0.0",
    "vite": "5.4.21",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "vite": "$vite"
  }
}
