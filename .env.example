# Public browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase credential. Never prefix this variable with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only SMTP configuration
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=StockFlow Notification

# MinIO/S3 configuration. Set the endpoint to the service hostname, not localhost,
# when the backend is running in Docker.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_BUCKET=stockflow
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
