# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Public browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase Service Role Key (Required for Admin RPCs / Serverless APIs)
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_APP_URL=

# ==============================================================================
# Application URL Configuration
# ==============================================================================
VITE_APP_URL=

# ==============================================================================
# SMTP Email Configuration (Vercel Serverless /api/send-email)
# ==============================================================================
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=StockFlow Notification

# ==============================================================================
# Cloudflare R2 Object Storage (Zero Egress Media / Attachments)
# ==============================================================================
# Server-only R2 S3-Compatible Credentials (Used by Serverless upload API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=stockflow-assets

# Public CDN URL for serving images & media in Frontend
VITE_R2_PUBLIC_URL=
