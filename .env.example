# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Public browser configuration
VITE_SUPABASE_URL=
# Preferred browser credential. Get this from Supabase Dashboard > Connect.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback for existing projects; use the publishable key above for new deployments.
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase Service Role Key (Required for Admin RPCs / Serverless APIs)
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_APP_URL=

# Direct Postgres connection for CLI migrations (scripts/apply-migration-*.mjs).
# ใช้ SUPABASE_DB_URL (connection string เต็ม) หรือ SUPABASE_DB_PASSWORD คู่กับ
# supabase/.temp/pooler-url ก็ได้ — ห้าม commit ค่าจริง
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=

# ==============================================================================
# Application URL Configuration
# ==============================================================================
VITE_APP_URL=

# ==============================================================================
# Cloudflare R2 Object Storage (Zero Egress Media / Attachments)
# ==============================================================================
# Server-only R2 S3-Compatible Credentials (Used by Serverless upload API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=stockflow-assets

# Public CDN URL for serving images & media in Frontend
VITE_R2_PUBLIC_URL=

# ==============================================================================
# Optional Firebase Configuration (If enabled)
# ==============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=


# ==============================================================================
# CAIM Integration (Claims & RMA System)
# ==============================================================================
CAIM_API_URL=https://claims-nu-taupe.vercel.app/api/tickets
CAIM_BASE_URL=https://claims-nu-taupe.vercel.app
CAIM_API_KEY=

# Shared HMAC-SHA256 secret verifying inbound webhooks at POST /api/caim-webhook
# Must be identical to CAIM_WEBHOOK_SECRET in the CAIM (claims) project
CAIM_WEBHOOK_SECRET=
